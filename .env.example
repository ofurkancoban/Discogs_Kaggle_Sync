# Kaggle Automatic Web Session Refresh Credentials
KAGGLE_USER=your_kaggle_username_or_email
KAGGLE_PASSWORD=your_kaggle_password

# AI cover art background generation (discogs_kaggle_sync/cover_art.py) - a fresh
# record-shop photo each month, composited with the logo and year/month text. Tries
# Cloudflare first, then Hugging Face, then falls back to the static assets/cover_art.png
# if neither is configured or both requests fail - all three are optional.

# Cloudflare Workers AI (free: 10,000 neurons/day, resets daily). Account ID is on the
# Workers & Pages overview page in the Cloudflare dashboard; create the token at
# dash.cloudflare.com/profile/api-tokens with the "Workers AI" template.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# Hugging Face token (free, from https://huggingface.co/settings/tokens) - secondary
# fallback; a small monthly credit allowance that heavy use can exhaust for the month.
HF=your_hugging_face_token
