# Kaggle Automatic Web Session Refresh Credentials
KAGGLE_USER=your_kaggle_username_or_email
KAGGLE_PASSWORD=your_kaggle_password

# Hugging Face token (free, from https://huggingface.co/settings/tokens) - used to
# generate a fresh AI cover art background each month (discogs_kaggle_sync/cover_art.py).
# Optional: falls back to the static assets/cover_art.png if unset or the request fails.
HF=your_hugging_face_token
